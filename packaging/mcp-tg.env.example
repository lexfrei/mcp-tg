# Copy to ~/.mcp-tg/env and chmod 0600 — this file holds credentials.
# systemd reads it verbatim: no export, no quotes, no shell expansion.

# From https://my.telegram.org/apps. Required; the public builds carry none.
TELEGRAM_APP_ID=
TELEGRAM_APP_HASH=

# The shared daemon: HTTP only, reachable from this machine alone.
MCP_HTTP_ONLY=true
MCP_HTTP_HOST=127.0.0.1
MCP_HTTP_PORT=8787

# Uncomment only if you logged in with --insecure-storage, which is the case on
# a machine with no Secret Service (a container, or a headless box). The backend
# must match on both sides, or the daemon looks for the session where it was
# never written. The session path itself needs no variable: it defaults to
# ~/.mcp-tg/session.json.
#TELEGRAM_SESSION_INSECURE=true
